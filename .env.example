# Copy to .env and fill in. Never commit .env. Values here are examples only.
# ---- database / API ----
DATABASE_URL=postgresql+psycopg://jarvis_app:CHANGE_ME@localhost:5432/jarvis
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/jarvis
JARVIS_APP_DB_PASSWORD=CHANGE_ME
N8N_WEBHOOK_SECRET=CHANGE_ME
TRUSTED_PROXY_COUNT=0                 # 1 when Caddy is in front of the API
ALERT_WEBHOOK_URL=                    # optional: Slack/Discord/Teams webhook for the watchdog
# ---- AI ----
GEMINI_API_KEY=CHANGE_ME
# ---- one line per company: the company's own AI key (made with: python -m app.owner company-new) ----
JARVIS_KEY_SMILE_DENTAL=CHANGE_ME
# ---- phone (LiveKit) ----
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
VOICE_NUMBERS=+14155550100=smile-dental
# ---- customer chat (QR code) ----
PUBLIC_BASE_URL=https://jarvis.example.com
CHAT_CODE_SMILE_DENTAL=                # made by: python -m app.webchat.qr new smile-dental
CHAT_PHONE_SMILE_DENTAL=+919876543210  # optional "Call us" link
CHAT_COUNTRY_CODE=+91

# ---- Indian languages (Hindi, Telugu, Tamil, ...) ----
# Phone calls: use Sarvam for speech. Get a key at https://dashboard.sarvam.ai
# VOICE_STACK=sarvam
# SARVAM_API_KEY=
# VOICE_LANGUAGE=en-IN                    # language the call starts in
# VOICE_LANGUAGES=hi-IN,te-IN,ta-IN       # extra languages the caller may switch to
# SARVAM_STT_MODE=realtime                # or: standard
# SARVAM_STT_LANGUAGE=                    # optional: force one listening language
# SARVAM_SPEAKER=                         # optional: Sarvam voice name
# Web chat: language buttons shown to customers
# CHAT_LANGUAGES=en-IN,hi-IN,te-IN,ta-IN
