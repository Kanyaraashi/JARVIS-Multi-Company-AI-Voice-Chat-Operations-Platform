# One-container public demo for Render (API + customer chat + Caddy). Build locally to test:  docker build -f Dockerfile.demo -t jarvis-demo .
FROM caddy:2 AS caddy

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

COPY requirements.txt requirements-chat.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-chat.txt

COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
COPY app ./app
COPY deploy/Caddyfile.demo deploy/demo-start.sh ./deploy/

RUN sed -i 's/\r$//' deploy/demo-start.sh deploy/Caddyfile.demo && useradd --create-home --uid 10001 jarvis && chmod +x deploy/demo-start.sh && chown -R jarvis:jarvis /app
USER jarvis

EXPOSE 10000
CMD ["bash", "/app/deploy/demo-start.sh"]
