# The customer web chat (QR code page). Build:  docker compose -f docker-compose.yml -f docker-compose.chat.yml build webchat
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

COPY requirements.txt requirements-chat.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-chat.txt

COPY app ./app

RUN useradd --create-home --uid 10001 jarvis && chown -R jarvis:jarvis /app
USER jarvis

EXPOSE 8100
CMD ["uvicorn", "app.webchat.server:app", "--host", "0.0.0.0", "--port", "8100", "--proxy-headers", "--no-access-log"]
